# GUI apps. Each is installed only if missing, so apps pushed by device management are left alone.
# PROFILE=work adds the work-only apps. Install: PROFILE=work brew bundle --file=Brewfile.apps
# UniFi endpoint (Ubiquiti) is not in Homebrew: install it from IT / Ubiquiti.
# OpenVPN: only the app is installed; import your .ovpn profile by hand.

# --- Everyone ---
cask "google-chrome" unless File.exist?("/Applications/Google Chrome.app")
cask "claude" unless File.exist?("/Applications/Claude.app")
cask "chatgpt" unless File.exist?("/Applications/ChatGPT.app")
cask "rectangle" unless File.exist?("/Applications/Rectangle.app")
mas "Amphetamine", id: 937984704 unless File.exist?("/Applications/Amphetamine.app")

# --- Work Mac ---
if ENV["PROFILE"] == "work"
  cask "microsoft-teams" unless File.exist?("/Applications/Microsoft Teams.app")
  cask "microsoft-word" unless File.exist?("/Applications/Microsoft Word.app")
  cask "microsoft-excel" unless File.exist?("/Applications/Microsoft Excel.app")
  cask "microsoft-edge" unless File.exist?("/Applications/Microsoft Edge.app")
  cask "adobe-creative-cloud" unless File.exist?("/Applications/Adobe Creative Cloud")
  cask "openvpn-connect" unless File.exist?("/Applications/OpenVPN Connect/OpenVPN Connect.app")
end
