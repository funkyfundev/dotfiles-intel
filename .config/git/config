# User-agnostic git settings. Name, email and signing key live in config.local (not tracked).
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    default = simple
    autoSetupRemote = true
[fetch]
    prune = true
[rerere]
    enabled = true
[merge]
    conflictStyle = zdiff3
[diff]
    colorMoved = default
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
    dark = true
[gpg]
    format = ssh
[alias]
    st = status -sb
    lg = log --oneline --graph --decorate
[include]
    path = config.local
